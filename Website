    const uniqueDays = new Set(
      careLogs.map(log => {
        const d = new Date(log.log_date || log.created_date);
        return `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
      })
    );
    const sortedDays = Array.from(uniqueDays).sort().reverse();
    let streak = 0;
    const today = new Date();
    for (let i = 0; i < sortedDays.length; i++) {
      const parts = sortedDays[i].split('-');
      const day = new Date(parseInt(parts[0]), parseInt(parts[1]), parseInt(parts[2]));
      if (differenceInDays(today, day) <= i + 1) streak++;
      else break;
    }
    return streak;
  };

  const getHealthTip = () => {
    if (!plant) return 'Create a plant profile to get started!';
    const levels = [
      { name: 'sunlight', level: plant.sunlight_level || 0 },
      { name: 'nutrients', level: plant.nutrient_level || 0 },
      { name: 'humidity', level: plant.humidity_level || 0 },
    ];
    const lowest = levels.reduce((a, b) => a.level < b.level ? a : b);
    if (lowest.level < 30) return `Your plant urgently needs more ${lowest.name} — it's at ${lowest.level}%. Give it some love!`;
    if (lowest.level < 60) return `Consider topping up ${lowest.name} soon. Plants thrive on consistency!`;
    return 'Your plant is thriving beautifully. Keep up the great care!';
  };

  const handleSaveAvatar = async (avatar) => {
    setIsSaving(true);
    await base44.auth.updateMe({ avatar });
    setUser(prev => ({ ...prev, avatar }));
    toast.success('Avatar saved!');
    setIsSaving(false);
  };

  const streak = calculateStreak();

  return (
    <motion.div
      className="space-y-5"
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
    >
      {/* Hero card */}
      <div className="relative overflow-hidden bg-gradient-to-br from-primary/10 via-card to-secondary/50 border border-border/50 rounded-3xl p-6 shadow-sm">
        {/* Decorative blobs */}
        <div className="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-primary/10 blur-2xl" />
        <div className="absolute -bottom-6 -left-6 w-24 h-24 rounded-full bg-accent/20 blur-2xl" />

        <div className="relative flex items-center gap-5">
          {/* Avatar */}
          <div className="relative flex-shrink-0">
            <div className="w-24 h-24 rounded-2xl bg-white/60 shadow-lg border border-white/80 flex items-center justify-center overflow-visible">
              <AvatarPreview avatar={user?.avatar} size={88} />
            </div>
            <div className="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-primary flex items-center justify-center shadow-md">
              <Leaf className="w-3 h-3 text-white" />
            </div>
          </div>

          {/* Name + email */}
          <div className="flex-1 min-w-0">
            <h2 className="font-playfair font-bold text-2xl text-foreground leading-tight truncate">
              {user?.full_name || 'Plant Parent 🌿'}
            </h2>
            <p className="text-sm text-muted-foreground truncate mt-0.5">{user?.email}</p>
            <div className="flex items-center gap-1 mt-2">
              <div className="h-2 w-2 rounded-full bg-emerald-500 animate-pulse" />
              <span className="text-xs text-emerald-600 font-semibold">Active gardener</span>
            </div>
          </div>
        </div>

        {/* Stats row */}
        <div className="relative mt-5 grid grid-cols-3 gap-3">
          {[
            { label: 'Day Streak', value: 8, icon: Flame, iconClass: 'text-orange-500', bg: 'bg-orange-50 border-orange-100' },
            { label: 'Care Actions', value: careLogs.length, icon: Heart, iconClass: 'text-rose-500', bg: 'bg-rose-50 border-rose-100' },
            { label: 'Plants', value: plants.length, icon: Leaf, iconClass: 'text-primary', bg: 'bg-primary/5 border-primary/10' },
          ].map(stat => (
            <div key={stat.label} className={`flex flex-col items-center p-3 rounded-2xl border ${stat.bg}`}>
              <stat.icon className={`w-4 h-4 mb-1 ${stat.iconClass}`} />
              <p className="text-xl font-bold text-foreground leading-none">{stat.value}</p>
