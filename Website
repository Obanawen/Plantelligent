}

export default function ChartsPage() {
  const [selectedDate, setSelectedDate] = useState(null);

  const { data: plants = [], isLoading } = useQuery({
    queryKey: ['plants'],
    queryFn: () => base44.entities.Plant.list('-created_date', 20),
