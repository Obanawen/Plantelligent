        </div>
      </div>

      {/* Health tip */}
      <div className="flex items-start gap-3 bg-primary/5 border border-primary/10 rounded-2xl p-4">
        <div className="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
          <Lightbulb className="w-4 h-4 text-primary" />
        </div>
        <div>
          <p className="text-xs font-bold text-primary uppercase tracking-wider mb-1">Plant Care Tip</p>
          <p className="text-sm text-foreground/80 leading-relaxed">{getHealthTip()}</p>
