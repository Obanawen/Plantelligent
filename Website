  const days = Array.from({ length: 28 }, (_, i) => subDays(new Date(), 27 - i));
  const activeDays = new Set(
    careLogs.map(l => format(new Date(l.log_date || l.created_date), 'yyyy-MM-dd'))
  );

  const handleClick = (key) => {
    onSelectDate(selectedDate === key ? null : key);
  };

  return (
    <div className="bg-card border border-border/50 rounded-2xl p-5 shadow-sm">
      <div className="flex items-center justify-between mb-4">
        <div className="flex items-center gap-2">
          <Calendar className="w-4 h-4 text-primary" />
          <h3 className="font-playfair font-semibold text-lg">Last 28 Days</h3>
        </div>
        {selectedDate && (
          <button onClick={() => onSelectDate(null)} className="text-xs text-muted-foreground hover:text-foreground underline">
            Clear
          </button>
        )}
      </div>
      <div className="grid grid-cols-7 gap-1.5">
        {['S','M','T','W','T','F','S'].map((d, i) => (
          <p key={i} className="text-center text-[10px] font-semibold text-muted-foreground mb-1">{d}</p>
        ))}
        {days.map((day, i) => {
          const key = format(day, 'yyyy-MM-dd');
          const active = activeDays.has(key);
          const isToday = isSameDay(day, new Date());
          const isSelected = selectedDate === key;
          return (
            <motion.div
              key={key}
              initial={{ scale: 0.8, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              transition={{ delay: i * 0.01 }}
              title={format(day, 'MMM d')}
              onClick={() => active && handleClick(key)}
              className={`aspect-square rounded-lg flex items-center justify-center text-[9px] font-bold transition-all ${
                active ? 'cursor-pointer' : 'cursor-default'
              } ${
                isSelected
                  ? 'ring-2 ring-primary ring-offset-1 bg-primary text-primary-foreground shadow-md scale-110'
                  : active
                  ? 'bg-primary text-primary-foreground shadow-sm hover:scale-105'
                  : isToday
                  ? 'bg-primary/20 text-primary border border-primary/40'
                  : 'bg-muted/50 text-muted-foreground'
              }`}
            >
              {format(day, 'd')}
            </motion.div>
          );
        })}
      </div>
      <p className="text-xs text-muted-foreground mt-3 text-center">
        {selectedDate
          ? `Showing care for ${format(new Date(selectedDate), 'MMM d')}`
          : `${activeDays.size} active days out of 28 — tap a day to filter`}
      </p>
    </div>
  );
}

function CareBreakdownChart({ careLogs, selectedDate }) {
  const filtered = selectedDate
    ? careLogs.filter(l => format(new Date(l.log_date || l.created_date), 'yyyy-MM-dd') === selectedDate)
    : careLogs;

  const data = Object.entries(careConfig).map(([key, cfg]) => ({
    name: cfg.label,
    sessions: filtered.filter(l => l.care_type === key).length,
    color: cfg.color,
  }));

  return (
    <div className="bg-card border border-border/50 rounded-2xl p-5 shadow-sm">
      <div className="flex items-center gap-2 mb-1">
        <TrendingUp className="w-4 h-4 text-primary" />
        <h3 className="font-playfair font-semibold text-lg">Care Breakdown</h3>
      </div>
      <p className="text-xs text-muted-foreground mb-4">
        {selectedDate ? `Sessions on ${format(new Date(selectedDate), 'MMM d')}` : 'Total sessions all time'}
      </p>
      <div className="h-48">
        <ResponsiveContainer width="100%" height="100%">
          <BarChart data={data} barCategoryGap="30%">
            <CartesianGrid strokeDasharray="3 3" stroke="hsl(var(--border))" vertical={false} />
            <XAxis dataKey="name" tick={{ fontSize: 11 }} stroke="hsl(var(--muted-foreground))" />
            <YAxis tick={{ fontSize: 11 }} stroke="hsl(var(--muted-foreground))" />
            <Tooltip
              contentStyle={{
                background: 'hsl(var(--card))',
                border: '1px solid hsl(var(--border))',
                borderRadius: '10px',
                fontSize: '12px',
              }}
            />
            <Bar dataKey="sessions" name="Sessions" radius={[6,6,0,0]}>
              {data.map((entry, i) => <Cell key={i} fill={entry.color} />)}
            </Bar>
          </BarChart>
        </ResponsiveContainer>
      </div>
    </div>
  );
}

function StatCards({ careLogs }) {
  return (
    <div className="grid grid-cols-3 gap-3">
      {Object.entries(careConfig).map(([key, cfg]) => {
        const Icon = cfg.icon;
        const logs = careLogs.filter(l => l.care_type === key);
        return (
          <div key={key} className={`${cfg.bg} rounded-2xl p-4 border border-border/30`}>
            <div className="flex items-center gap-2 mb-2">
              <Icon className={`w-4 h-4 ${cfg.text}`} />
              <span className="text-xs font-semibold text-muted-foreground">{cfg.label}</span>
            </div>
            <p className="text-2xl font-bold text-foreground">{logs.length}</p>
            <p className="text-[10px] text-muted-foreground mt-0.5">sessions logged</p>
          </div>
